.loading,
.empty {
  padding: 56rpx 28rpx;
  text-align: center;
  color: #6b7280;
}

.phone-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.phone-title {
  font-size: 28rpx;
  font-weight: 700;
}

.phone-subtitle {
  margin-top: 8rpx;
  color: #6b7280;
  font-size: 24rpx;
}

.bind-phone {
  margin: 0;
  flex-shrink: 0;
}

.hero {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 18rpx 0 10rpx;
}

.eyebrow {
  color: #0f766e;
  font-size: 24rpx;
  font-weight: 700;
}

.project-title {
  margin: 8rpx 0 0;
  padding: 0;
  color: #0f172a;
  background: transparent;
  font-size: 48rpx;
  font-weight: 800;
  line-height: 1.15;
  text-align: left;
}

.project-title::after {
  border: 0;
}

.export-button {
  margin: 0;
}

.stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-top: 18rpx;
}

.stat-card {
  min-height: 132rpx;
  box-sizing: border-box;
  padding: 22rpx 18rpx;
  background: #ffffff;
  border: 1rpx solid #e5e7eb;
  border-radius: 12rpx;
}

.stat-label {
  display: block;
  color: #6b7280;
  font-size: 24rpx;
}

.stat-value {
  display: block;
  margin-top: 14rpx;
  color: #111827;
  font-size: 30rpx;
  font-weight: 800;
}

.filter-card {
  display: grid;
  grid-template-columns: 1fr 172rpx 132rpx;
  gap: 14rpx;
  padding: 18rpx;
}

.filter-input,
.filter-picker {
  height: 72rpx;
  box-sizing: border-box;
  padding: 16rpx 18rpx;
  background: #f9fafb;
  border: 1rpx solid #e5e7eb;
  border-radius: 10rpx;
  font-size: 26rpx;
}

.filter-button {
  margin: 0;
}

.list-header {
  margin-top: 28rpx;
}

.list-title {
  font-size: 32rpx;
  font-weight: 800;
}

.expense-list {
  margin-top: 14rpx;
}

.expense-card {
  padding: 24rpx;
  margin-bottom: 18rpx;
}

.expense-name {
  max-width: 420rpx;
  font-size: 30rpx;
  font-weight: 800;
}

.expense-amount {
  color: #0f766e;
  font-size: 30rpx;
  font-weight: 800;
}

.expense-meta,
.expense-foot {
  margin-top: 14rpx;
  color: #6b7280;
  font-size: 24rpx;
}

.add-button {
  position: fixed;
  right: 34rpx;
  bottom: 48rpx;
  width: 104rpx;
  height: 104rpx;
  line-height: 96rpx;
  border-radius: 52rpx;
  color: #ffffff;
  background: #0f766e;
  font-size: 56rpx;
  box-shadow: 0 12rpx 28rpx rgba(15, 118, 110, 0.28);
}

.modal-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 10;
  display: flex;
  align-items: flex-end;
  background: rgba(15, 23, 42, 0.45);
}

.pair-card {
  display: grid;
  grid-template-columns: 1fr 180rpx 128rpx;
  gap: 16rpx;
  align-items: center;
  margin: 24rpx 0;
  padding: 24rpx;
}

.pair-title {
  margin-bottom: 6rpx;
  font-weight: 800;
}

.pair-input {
  text-align: center;
  letter-spacing: 4rpx;
}

.pair-button {
  margin: 0;
}

.loading-more {
  padding: 24rpx 0 120rpx;
  text-align: center;
  color: #64748b;
  font-size: 24rpx;
}

.project-panel {
  width: 100%;
  max-height: 82vh;
  box-sizing: border-box;
  padding: 28rpx;
  border-radius: 24rpx 24rpx 0 0;
  overflow-y: auto;
}

.panel-title {
  font-size: 34rpx;
  font-weight: 800;
}

.close-button,
.small-button,
.mini-button {
  margin: 0 0 0 12rpx;
}

.small-button {
  width: 132rpx;
  flex-shrink: 0;
}

.project-input,
.advance-input {
  flex: 1;
}

.project-list {
  margin-top: 26rpx;
}

.project-row {
  padding: 20rpx 0;
  border-top: 1rpx solid #e5e7eb;
}

.project-name-wrap {
  flex: 1;
}

.project-name {
  font-size: 29rpx;
  font-weight: 700;
}

.active-dot {
  margin-left: 12rpx;
  padding: 4rpx 10rpx;
  color: #0f766e;
  background: #ccfbf1;
  border-radius: 999rpx;
  font-size: 22rpx;
}

.rename-box {
  display: grid;
  grid-template-columns: 1fr 132rpx;
  gap: 12rpx;
}

.mini-button {
  width: 100rpx;
  padding: 0;
  font-size: 24rpx;
}
